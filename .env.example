# Supabase connection — PUBLIC values only.
# On Vercel: Project → Settings → Environment Variables (same two names).
# Locally: copy this file to .env (never committed).
#
# Without these the site runs on its built-in local catalog, exactly as before.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service_role / secret key here: it would be sent to every visitor.
